APP_ORIGIN=http://localhost:3000
PORT=3000
# Endereço público HTTPS após hospedagem (sem usar localhost).
APP_PUBLIC_URL=
# Preencher somente depois de publicar o aplicativo na Google Play.
PLAY_STORE_URL=
# Configurar no servidor; nunca colocar chaves no HTML ou no aplicativo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Envio real só é ativado após configurar credenciais Expo/FCM/APNs e dispositivo.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Alternativa SMTP (Locaweb). Senha apenas no arquivo local .env.
MAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_B64=
